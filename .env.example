PORT=4173

# Optional local content-authoring configuration.
# The published GitHub Pages app does not need AI credentials.
AI_DEFAULT_PROVIDER=google-cloud
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4

# Protect any locally enabled generation/admin endpoints with a long random value.
ADMIN_TOKEN=replace-with-a-long-random-value
