PORT=4173
AI_DEFAULT_PROVIDER=google

# Google AI Studio / Gemini API — text, QA and TTS
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_TTS_VOICE=Sulafat

# Optional Google Cloud / Vertex (Gemini Enterprise Agent Platform Express mode)
# If VERTEX_API_KEY is set, image generation uses Cloud/Vertex first while TTS stays on GEMINI_API_KEY.
VERTEX_API_KEY=

# OpenAI API
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional admin protection for generation endpoints
ADMIN_TOKEN=change-me
